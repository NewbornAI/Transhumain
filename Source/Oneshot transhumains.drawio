        </mxCell>
        <mxCell id="8rTfS2ikIlfR6d946OIm-20" value="Pourquoi pas détruit ?????" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
