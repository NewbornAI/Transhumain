        <mxCell id="GDcSQ-y1RcjGkifnNb_F-1" value="Animaux étranges :&lt;div&gt;long cou&lt;/div&gt;&lt;div&gt;gros oiseaux&lt;/div&gt;&lt;div&gt;araignées crabes&lt;/div&gt;&lt;div&gt;singes volants&lt;/div&gt;&lt;div&gt;insectes démesurés&lt;/div&gt;&lt;div&gt;anguilles de 3m&lt;br&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;rounded=0;" vertex="1" parent="1">
