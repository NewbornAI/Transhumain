        <mxCell id="8rTfS2ikIlfR6d946OIm-26" value="&lt;div&gt;Vos muscles sont raides, et le simple effort de vous lever vous laisse à court de souffle.&lt;/div&gt;&lt;div&gt;Classique mal d&#39;hibernation : vous y êtes habitué, ça passera avec une bonne nuit de repos.&lt;br&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;shape=mxgraph.basic.roundRectCallout;dx=30;dy=15;size=5;boundedLbl=1;" vertex="1" parent="1">
