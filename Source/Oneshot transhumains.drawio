        <mxCell id="8rTfS2ikIlfR6d946OIm-27" value="&lt;div&gt;Jungle épaisse et humide. Plantes bleues. 0.2g (~Luna).&lt;br&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;rounded=0;" vertex="1" parent="1">
