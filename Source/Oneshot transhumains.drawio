        <mxCell id="8rTfS2ikIlfR6d946OIm-17" value="&lt;div align=&quot;left&quot;&gt;Vêtements&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;Combinaisons&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;Bouteilles d&#39;oxygène&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;Matériel de camping&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;Lampe torche&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;Maglame&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;Générateur (Carbon14 1kg, 1W)&lt;br&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;1 mois de nourriture (lourd)&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;Eau (lourd)&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;Medkit&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;Scanner&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;Pistolet&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;Balles gel (1 chargeur)&lt;/div&gt;" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;rounded=0;align=left;" vertex="1" parent="1">
